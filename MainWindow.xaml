<Window x:Class="Numb.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Numb - Touch &amp; Input Freeze" Height="320" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Numb" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="Input &amp; Touchscreen Locker" FontSize="13" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Margin="0,2,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <Border x:Name="StatusCard" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock x:Name="StatusText" Text="Status: Unlocked" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="When locked, keyboard, mouse, and touchscreen input are swallowed." FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Unlock Shortcut:" FontWeight="Bold" Margin="0,16,0,4"/>
            <Border Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" Padding="8,4" HorizontalAlignment="Left" CornerRadius="4">
                <TextBlock Text="Ctrl + Alt + Shift + U" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="LockButton" Content="Lock Input &amp; Touch" Width="170" Height="38" FontWeight="Bold" Click="LockButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
